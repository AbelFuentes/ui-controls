{
  "name": "@abelfuentes/ui-controls",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": [
    "./src/index.js",
    "./src/components/*.js",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.js",
    "./theme": "./src/core/theme.js",
    "./theme-switch": "./src/components/theme-switch.js",
    "./toggle": "./src/components/toggle.js",
    "./checkbox": "./src/components/checkbox.js",
    "./radio": "./src/components/radio.js",
    "./radio-group": "./src/components/radio-group.js",
    "./segmented": "./src/components/segmented.js",
    "./slider": "./src/components/slider.js",
    "./stepper": "./src/components/stepper.js",
    "./tabs": "./src/components/tabs.js",
    "./button": "./src/components/button.js",
    "./input": "./src/components/input.js",
    "./select": "./src/components/select.js",
    "./textarea": "./src/components/textarea.js",
    "./card": "./src/components/card.js",
    "./carousel": "./src/components/carousel.js",
    "./alert": "./src/components/alert.js",
    "./app-shell": "./src/components/app-shell.js",
    "./avatar": "./src/components/avatar.js",
    "./badge": "./src/components/badge.js",
    "./grid": "./src/components/grid.js",
    "./progress": "./src/components/progress.js",
    "./skeleton": "./src/components/skeleton.js",
    "./spinner": "./src/components/spinner.js",
    "./stack": "./src/components/stack.js",
    "./tokens.css": "./src/tokens.css",
    "./accordion": "./src/components/accordion.js",
    "./breadcrumb": "./src/components/breadcrumb.js",
    "./dialog": "./src/components/dialog.js",
    "./drawer": "./src/components/drawer.js",
    "./dropdown": "./src/components/dropdown.js",
    "./pagination": "./src/components/pagination.js",
    "./table": "./src/components/table.js",
    "./toast": "./src/components/toast.js",
    "./tooltip": "./src/components/tooltip.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "storybook": "^10.6.1",
    "@storybook/web-components-vite": "^10.6.1",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "lit": "latest",
    "vitest": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest"
  },
  "scripts": {
    "dev": "vite demo",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "description": "Controles UI atómicos como Web Components. Funcionan en cualquier página.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web-components",
    "ui",
    "dark-mode",
    "theme-switch"
  ]
}
